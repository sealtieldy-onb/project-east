# Local-only East configuration. Copy to .env and replace the blank/placeholder values.
# Keep .env on this computer only; it is excluded from version control.

# Spring Boot API port. The API always binds to IPv4 loopback; its address cannot be configured.
EAST_SERVER_PORT=8080
EAST_FRONTEND_ORIGIN=http://localhost:5173

# Google Cloud Console -> OAuth client ID (Web application).
# The authorized redirect URI must exactly match this callback.
EAST_GOOGLE_CLIENT_ID=
EAST_GOOGLE_CLIENT_SECRET=
EAST_GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# Local PostgreSQL service. East publishes it on loopback port 15432 by default;
# change EAST_DB_PORT if that port is already in use. Use a unique local password.
EAST_DB_PORT=15432
EAST_DB_NAME=east
EAST_DB_USER=east
EAST_DB_PASSWORD=

# The OpenAI API key is entered through East settings and encrypted in the local
# vault. Do not place it in this file.
